{
    "name": "linguini",
    "version": "2.0.0-alpha.0",
    "author": "Kevin Novak",
    "contributors": [
        "Scott Bucher"
    ],
    "description": "Typed, ICU-based JSON translation catalogs: compile-time checked keys and parameters, CLDR plurals, Intl formatting, and hot-reloadable catalog artifacts.",
    "license": "MIT",
    "private": false,
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./compiler": {
            "types": "./dist/compiler/index.d.ts",
            "import": "./dist/compiler/index.js"
        }
    },
    "bin": {
        "linguini": "dist/cli/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "prepare": "npm run build",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@formatjs/icu-messageformat-parser": "^2.9.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@vitest/coverage-v8": "^3.2.7",
        "eslint": "^9.17.0",
        "fast-check": "^4.9.0",
        "prettier": "^3.4.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.19.0",
        "vitest": "^3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/KevinNovak/Linguini"
    },
    "keywords": [
        "i18n",
        "icu",
        "icu-messageformat",
        "internationalization",
        "intl",
        "json",
        "language",
        "linguini",
        "locale",
        "localization",
        "multilingual",
        "plurals",
        "translate",
        "translation",
        "typed",
        "typescript"
    ]
}
